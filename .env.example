# Neuron — local configuration.
#
# Copy this file to `.env` beside it and edit that copy. `.env` is gitignored
# and must never be committed; this file IS committed and must therefore never
# hold a real secret. Everything below is a placeholder.
#
# A real environment variable always beats a value set here. That is what lets
# the same code run in both places: on a laptop this file supplies the values,
# while in production no `.env` file is shipped at all and the hosting platform
# sets real environment variables instead.
#
# `PORT` and `AUDIO_PATH` are optional and the values below are also their
# defaults, so copying those two changes nothing. **`JWT_SECRET` is required and
# the placeholder below will not work** — a straight copy of this file no longer
# boots, deliberately, and its section says how to generate one. `DATABASE_URL`
# and `WEB_ORIGIN` are required too, and the values below are the right ones
# for local development.
#
# A variable that is set but unusable stops the API from starting, with a message
# naming the variable and quoting the value. See
# docs/decisions/ADR-007-configuration-and-boot-validation.md.

# The TCP port the API listens on.
# Must be a whole number between 1 and 65535. Anything else — empty, 0,
# negative, above the range, text, or a number with stray spaces around it —
# refuses to boot rather than being quietly corrected.
# Remove the line entirely to use the default, 3000.
PORT=3000

# Which Postgres database holds the journal. REQUIRED — there is no default,
# and the API refuses to start without it. `pnpm migration:run` reads it too.
#
# The form is postgres://user:password@host:port/database. The value below is
# the server `compose.yaml` describes, on this laptop only: start it with
# `docker compose up -d` from the repository root before `migration:run`,
# `dev` or the tests. Its user and password are `neuron`, which is not a
# secret, because the server answers only on this machine. A deployed
# database has a real password, set by the hosting platform and never here.
#
# A value that is not a Postgres address refuses to boot, and the message
# hides the password. A database that is not there, or a server that is not
# running, stops the start too, rather than looking like an empty journal.
#
# The tests do not use this database. They make their own, one per test file,
# in the server TEST_DATABASE_URL names, which is this same server by
# default, and drop each when its file is done.
DATABASE_URL=postgres://neuron:neuron@localhost:5432/neuron

# The folder the audio of voice memos is kept in. Optional.
# A relative path is resolved from the directory the API process was started
# in, which is `apps/api` for `pnpm dev`. When it is not set, the folder is
# `apps/api/data/audio`, wherever the API was started from. The folder is made
# when the API starts, and a path that cannot be a folder stops the start.
# It is never served as plain files: audio leaves the API only through a
# signed-in route that checks whose memo it is. See
# docs/decisions/ADR-023-audio-files-on-the-api-disk.md.
# AUDIO_PATH=data/audio

# The key that signs every access token. REQUIRED — there is no default and no
# fallback, and the API refuses to start without it.
#
# The value below is a placeholder and must be replaced. It is the right length
# and it is in version control, which is exactly what makes it useless: anyone
# who can read this repository could use it to forge a token for any user. That
# is the reason there is no default in the code either — a built-in secret looks
# configured while protecting nothing.
#
# Generate your own, once, and keep it out of git:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Must be at least 32 characters. That is a length floor rather than a strength
# test — no check can measure the entropy of a single string — and what it rules
# out is the failure that actually happens: a short word copied from a tutorial.
#
# Changing it invalidates every token already issued, so every signed-in client
# is logged out. See docs/decisions/ADR-012-authentication-endpoints.md.
JWT_SECRET=replace-this-placeholder-with-a-generated-value

# The one origin whose pages may read this API's responses from a browser: the
# address the web app is served from. REQUIRED — there is no default, and the
# API refuses to start without it. It is a security boundary rather than a
# convenience setting, so every environment has to name the frontend it trusts.
#
# An origin is a scheme, a host and an optional port, written exactly as a
# browser sends it: no path, no trailing slash, no spaces, host in lower case.
# `http://localhost:3001` is valid. `http://localhost:3001/`, `localhost:3001`
# and `*` are not, and each refuses to boot rather than being quietly corrected.
#
# The value below is where `pnpm dev:web` serves the web app, so it is correct
# for local development as it stands. See
# docs/decisions/ADR-018-browser-credential-and-cors.md.
WEB_ORIGIN=http://localhost:3001
