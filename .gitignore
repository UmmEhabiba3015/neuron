# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables (but keep example files as templates)
.env
.env.*
!.env.example

# Test coverage
coverage/

# SQLite database — local state, never source. A pattern without a leading
# slash matches at any depth, so this covers apps/api/data/neuron.db too.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Worker artifacts — prompts and reports stay local, not in version control
docs/workers/
docs/learning/**/report.md
docs/learning/**/worker-report-*.md
