# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables (but keep example files as templates)
.env
.env.*
!.env.example

# Test coverage
coverage/

# SQLite database — local state, never source. A pattern without a leading
# slash matches at any depth, so this covers apps/api/data/neuron.db too.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Worker artifacts — prompts and reports stay local, not in version control
docs/workers/
docs/learning/**/report.md
docs/learning/**/worker-report-*.md

# Exception: the Day 8 TypeORM study report. It is a record of a learning
# session rather than a worker artifact, and it is the evidence that the debt
# blocking Day 9 was actually repaid — which the roadmap, master-state and
# HANDOFF all point at. Narrow on purpose: whether the rule above still earns
# its place for the rest of the reports is a Day 14 decision, and this does not
# pre-empt it.
!docs/learning/day-08/report.md
!docs/learning/day-09/report.md
!docs/learning/day-10/report.md
