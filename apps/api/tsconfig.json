{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // Which @types packages are loaded as *globals*. Listing them explicitly
    // isn't style: TypeScript 6 stopped picking up @types/jest automatically
    // here, so `describe`/`it`/`expect` resolved to nothing and every spec file
    // lit up with "Cannot find name". Packages imported by name
    // (supertest, express) are unaffected — this list only governs globals.
    //
    // `baseUrl` used to sit here (Nest's generator adds it). Removed: it is
    // deprecated in TS 6, gone in TS 7, and did nothing without `paths`.
    "types": ["jest", "node"],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
